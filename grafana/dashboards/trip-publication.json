          "editorMode": "code",
          "expr": "sum by (result) (rate(sharetrip_trip_publish_total{job=\"sharetrip\"}[5m]))",
          "legendFormat": "{{result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Trip publication rate",
      "type": "timeseries",
      "description": "Вызовы PublishTrip в секунду по результату, среднее за 5 минут."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
