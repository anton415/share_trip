      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(sharetrip_trip_publish_total{job=\"sharetrip\",result!=\"success\"}[5m])) or (0 * sum(rate(sharetrip_trip_publish_total{job=\"sharetrip\"}[5m])))) / sum(rate(sharetrip_trip_publish_total{job=\"sharetrip\"}[5m]))",
          "legendFormat": "errors / all publications",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Trip publication error rate",
      "type": "timeseries",
      "description": "Доля результатов PublishTrip, отличных от success, включая отказ в доступе. При отсутствии вызовов доля не определена."
